{
  "about": "The persona lab's players (scripts/studio/personas). Each persona plays the game three ways: a sim pilot with their habits fights hundreds of headless battles (fun and balance), a browser bot plays the real build with their device, input, settings, eyesight and network (stability, playability, accessibility, beauty), and a brief lets an AI playtester play as them and write a verdict. Every persona scores the five pillars 0-100; `weights` says how much each pillar matters to them for their overall score. `musts` are journeys that persona has to finish, or the run fails.",
  "pillars": ["stability", "playability", "fun", "accessibility", "beauty"],
  "ladder": {
    "why": "A copy of LADDER in src/screens/battle/battle.ts (the debrief's Next rungs). sim.ts checks the two still agree.",
    "rungs": [
      { "preset": "easy", "difficulty": "easy" },
      { "preset": "difficult", "difficulty": "easy" },
      { "preset": "easy", "difficulty": "difficult" },
      { "preset": "hard", "difficulty": "easy" },
      { "preset": "difficult", "difficulty": "difficult" },
      { "preset": "hard", "difficulty": "difficult" },
      { "preset": "hard", "difficulty": "hard" }
    ]
  },
  "palettePairs": {
    "why": "Colour pairs a player must tell apart. Read live from the page's CSS, then simulated for each colour-vision type (Machado 2009) and compared by CIEDE2000; below `minDeltaE` the pair only differs by hue that player can't see. \"labelled\": a letter or icon also tells them apart, so a miss is minor.",
    "minDeltaE": 12,
    "pairs": [
      ["--text-player-primary", "--text-enemy-primary", "your ships vs theirs"],
      ["--surface-player-body", "--surface-enemy-body", "your panels vs theirs"],
      ["--dc-a", "--dc-y", "A (go) vs Y (menu) buttons", "labelled"],
      ["--accent-destructive", "--dc-y", "danger vs ok"],
      ["--dc-accent", "--text-enemy-primary", "focus cursor vs enemy"]
    ]
  },
  "jargon": {
    "why": "Words the plain-language copy rules retired or that trip a reader on game screens (kid-audience layer: ship, machine and layer, not hull, struct and battleground). Counted on screens for checks.reading.",
    "words": ["struct", "ambit", "hull", "battleground", "LCD", "GRASS", "alpha", "infusion", "substation", "allocation", "reactor", "mempool", "tx", "nonce", "PoW"]
  },
  "views": {
    "desktop": { "w": 1440, "h": 900 },
    "tv": { "w": 640, "h": 480 },
    "phone": { "w": 390, "h": 844, "mobile": true, "dpr": 3 },
    "phone-small": { "w": 360, "h": 640, "mobile": true, "dpr": 2 },
    "tablet": { "w": 1024, "h": 768, "mobile": true, "dpr": 2 },
    "laptop-old": { "w": 1366, "h": 768 },
    "zoom-200": { "w": 720, "h": 450, "dpr": 2, "why": "a 1440×900 screen at 200% browser zoom: half the CSS pixels, twice the density" },
    "ultrawide": { "w": 3440, "h": 1440 }
  },
